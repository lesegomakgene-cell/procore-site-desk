# Copy this file to ".env" and restart the server.

# Required: your Anthropic API key (stays on this computer, never sent to the browser)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Optional
MODEL=claude-opus-5-5   # the model that reads the email and drawings
EFFORT=high             # low | medium | high | xhigh | max - higher = more thorough, slower, costlier
MAX_TOKENS=32000        # room for the written analysis
PORT=3100

# By default the app only listens on this computer (127.0.0.1).
# To use it from your phone on the same network, set HOST=0.0.0.0 AND set a password.
HOST=127.0.0.1
APP_PASSWORD=
