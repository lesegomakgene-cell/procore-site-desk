# Copy this file to ".env" for LOCAL use, then restart the server.
# (On Render you set these in the dashboard instead, not in this file.)

# Shown at the top of printed reports
COMPANY_NAME=

# Required when the app is reachable from other machines (HOST=0.0.0.0 or Render).
# Everyone on the team uses this one password.
APP_PASSWORD=

# Optional: turns on the "AI summary" button on reports. Kept server-side only.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
EFFORT=medium

# Where inspections, actions and photos are kept (relative to this folder)
DATA_DIR=data
PORT=3200
# HOST=0.0.0.0   # let phones on the same Wi-Fi connect (needs APP_PASSWORD)
