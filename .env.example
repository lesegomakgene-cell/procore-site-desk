# Copy this file to ".env" to run on your own computer. On Render you set these
# in the dashboard (Environment tab) instead - this file is not used there.

# --- The assistant ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
MODEL=claude-sonnet-5-5            # cheaper and faster: claude-haiku-5-5
DAILY_LIMIT=100                    # questions per person per day (protects your credit). 0 = no limit

# --- You ---------------------------------------------------------------------
SITE_AGENT_NAME=Lesego
SITE_AGENT_WHATSAPP=               # e.g. 0821234567 - people can message you if an alert fails
SITE_AGENT_EMAIL=                  # optional - shown to people as another way to reach you

# --- Security ------------------------------------------------------------------
ADMIN_PASSWORD=                    # protects /admin. Leave blank and the admin page is switched off
SIGNUP_CODE=                       # a word or number the team needs to create an account
STORE_QUESTIONS=false              # true = keep the first 200 characters of each question (default: topic only)

# --- Getting told about live-session requests ----------------------------------
RESEND_API_KEY=                    # free at resend.com
NOTIFY_EMAIL=                      # the SAME email you signed up to Resend with
REQUEST_WEBHOOK_URL=               # optional: a Slack or Discord webhook

# --- Where accounts and statistics are saved -----------------------------------
# DATA_DIR=/var/data               # on Render, a disk mounted here is used automatically
PORT=3000
